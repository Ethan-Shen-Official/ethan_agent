# Copy this file to .env and fill in your own values.
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# NEVER commit a real .env — it is ignored by .gitignore.
# The provider reads these variables at startup from the environment,
# with .env values only filling gaps (real env vars take precedence).

# --- Required: model API credentials (use YOUR OWN keys) ---
# The first non-empty variable in each group wins.
CODING_AGENT_API_KEY=sk-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# API_KEY=sk-your-key-here

# OpenAI-compatible endpoint (DeepSeek / OpenAI / local vLLM / ...).
# A trailing /chat/completions is appended automatically if missing.
CODING_AGENT_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# BASE_URL=https://api.deepseek.com/v1

# --- Optional ---
# Model name (default: deepseek-v4-flash).
CODING_AGENT_MODEL=deepseek-v4-flash
# DEEPSEEK_MODEL=deepseek-v4-flash
# MODEL=deepseek-v4-flash

# Request timeout in seconds (default: 120).
# CODING_AGENT_TIMEOUT=120
# OPENAI_TIMEOUT=120

# Default permission mode for tool calls: default | accept_edits | bypass_permissions
# (used by the ACP bridge; the CLI also accepts --permission-mode).
# CODING_AGENT_PERMISSION_MODE=default

# Directory for persisted sessions.
# Defaults to <workspace>/.agent/sessions.
# CODING_AGENT_SESSION_DIR=C:/path/to/sessions
